{
  "name": "lectiq",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "//engines": "The unit tests run .ts files directly, which needs unflagged type stripping. It landed in Node 22.18 and is unflagged from 23.6, so CI pins 24.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/unit/*.test.ts",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "test:all": "npm run test && npm run test:browser",
    "test:types": "tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.510.0",
    "next": "16.2.7",
    "pdfjs-dist": "^4.0.379",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.3.8",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "playwright": "^1.64.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
